# 将本文件复制为 conf/sparkone.conf，供本地 IDEA 或 CLI 启动使用。

server {
  host = "127.0.0.1"
  port = 7070
  logLevel = "info"
  # Run 默认隐藏转译后的 SQL；调试时可设为 true，在页面展示每条语句的转译结果。
  showCompiledSql = false
}

spark {
  master = "local[*]"
  # local 模式会自动使用 127.0.0.1。
  # 如果使用 YARN/client 模式，driverHost 应配置为 executor 可访问的地址。
  # driverHost = "127.0.0.1"
  # driverBindAddress = "127.0.0.1"

  kerberos {
    principal = "odep@HADOOP.COM"
    keytab = "/Users/qindongliang/bigdata/odep.keytab"
  }
}

hadoop {
  confDir = "/Users/qindongliang/bigdata/hadoop/etc/hadoop"
  groupStaticOverrides = "odep=odep"
  # confFiles = "/path/to/core-site.xml,/path/to/hdfs-site.xml"
}

hive {
  enabled = true
  confFile = "/Users/qindongliang/bigdata/hive/conf/hive-site.xml"
  # confDir = "/Users/qindongliang/bigdata/hive/conf"
}

kerberos {
  krb5Conf = "/etc/krb5.conf"
}

save {
  # 文件覆盖写风险较高，默认要求每条 save 语句显式确认，例如：
  # options sparkoneOverwrite="allow"
  overwritePolicy = "requireExplicit"
  # 目标已存在时，先按备份策略处理旧目录；支持：rename、trash、none。
  overwriteBackup = "rename"
  # rename 备份根目录。不带 scheme 的路径会按 save 目标所在文件系统解析。
  overwriteBackupPath = "/tmp/sparkone_back"
  # 默认禁止 MySQL overwrite。该行为可能 truncate 或 drop/recreate 目标表，只有明确接受风险时再打开。
  # 打开后，单条 save overwrite mysql 仍然需要 options sparkoneOverwrite="allow"。
  allowMysqlOverwrite = false
  # 默认禁止原生 Spark SQL 的 INSERT OVERWRITE，避免绕过 SparkOne Safe Save。
  # 历史脚本确实需要兼容时，再显式改为 true。
  allowNativeInsertOverwrite = false
  # 默认禁止原生 Spark SQL 的 DROP TABLE，避免误删 Hive/catalog 表。
  # 该开关只允许通过启动配置打开，不允许被 SQL 或 SET 覆盖。
  allowNativeDropTable = false
  # 全局保护 overwrite 边界路径。命中后不允许被 SQL 参数或 SET 覆盖。
  # 规则：禁止覆盖这些路径本身以及它们的上级目录；允许覆盖其下更具体的业务目录。
  # 例如配置 "/public/odep/user" 后，"/public/odep/user" 会被拦截，
  # "/public/odep/user/userA" 可以写。
  # 支持整段通配符 "*"：例如 "/*" 保护所有一级目录，"/*/*" 保护所有一级和二级目录。
  # 不带 scheme 的路径会按 save 目标所在文件系统解析。
  # overwriteProtectedPaths = [
  #   "/",
  #   "/user",
  #   "/tmp",
  # ]
}

datasources.mysql {
  # MySQL 连接统一放在 HOCON 中，SQL 里只引用连接名，例如 mysql.`analytics.users`。
  analytics {
    url = "jdbc:mysql://127.0.0.1:3306/app?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&tinyInt1isBit=false"
    driver = "com.mysql.cj.jdbc.Driver"
    user = "root"
    password = "change-me"

    # 这里放 Spark JDBC reader/writer 通用参数；SQL 里的 options 可继续补充 batchsize、fetchsize 等非连接参数。
    options {
      fetchsize = 1000
      batchsize = 1000
    }
  }
}

catalogs {
  doris {
    # Spark Doris Catalog 固定注册为 catalog 名 doris。
    # SQL 主路径：show namespaces in doris; select * from doris.db.table;
    fenodes = "127.0.0.1:8030"
    queryPort = 9030
    user = "root"
    password = "change-me"

    # 这里放 Spark Doris Catalog 参数，例如 doris.request.retries、doris.read.mode 等。
    options {
      doris.request.retries = 3
    }
  }
}

jars {
  # 等价于 spark-submit --packages / spark.jars.packages。
  # packages = "dev.mauch:spark-excel_2.12:3.5.6_0.31.2"
  # MySQL 连接器也可以用 packages 引入，例如：
  # packages = "com.mysql:mysql-connector-j:8.4.0"
  # Doris 4.x / Spark 3.5 可引入：
  # packages = "org.apache.doris:spark-doris-connector-spark-3.5:25.2.0"
  # 等价于 spark-submit --jars / spark.jars，用于依赖类 JAR。
  # jars = "/path/to/provider.jar,/path/to/another-provider.jar"
  # 等价于 spark-submit --files / spark.files，用于普通文件，不用于依赖类 JAR。
  # files = "/path/to/app.conf,/path/to/dict.txt"
  # packages 解析时使用的额外 Maven 仓库。
  # repositories = "https://repo1.maven.org/maven2"
}
