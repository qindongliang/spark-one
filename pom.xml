<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.sparkone</groupId>
    <artifactId>spark-one-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>SparkOne Parent</name>
    <description>Aggregator for SparkOne server and Spark engine provider modules.</description>

    <modules>
        <module>sparkone-server</module>
        <module>sparkone-mysql-provider</module>
        <module>sparkone-hdfs-overwrite-extension</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <scala.version>2.12.19</scala.version>
        <scala.binary.version>2.12</scala.binary.version>
        <spark.version>3.5.7</spark.version>
        <antlr4.version>4.9.3</antlr4.version>
        <javalin.version>4.6.7</javalin.version>
        <codemirror.version>5.65.19</codemirror.version>
        <jackson.version>2.15.2</jackson.version>
        <typesafe.config.version>1.4.3</typesafe.config.version>
        <kyuubi.jdbc.version>1.9.4</kyuubi.jdbc.version>
        <curator.version>2.13.0</curator.version>
        <slf4j.version>2.0.7</slf4j.version>
        <junit.version>4.13.2</junit.version>
    </properties>
</project>
